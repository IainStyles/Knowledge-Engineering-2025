<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://www.dummy.info/new.owl"
         xmlns="http://www.dummy.info/new.owl#">

<owl:Ontology rdf:about="http://www.dummy.info/new.owl"/>

<owl:ObjectProperty rdf:about="#offers_program">
  <rdfs:domain rdf:resource="#School"/>
  <rdfs:range rdf:resource="#Program"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#has_module">
  <rdfs:domain rdf:resource="#Program"/>
  <rdfs:range rdf:resource="#Module"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#is_enrolled_on">
  <rdfs:domain rdf:resource="#Student"/>
  <rdfs:range rdf:resource="#Program"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#is_taught_by">
  <rdfs:domain rdf:resource="#Module"/>
  <rdfs:range rdf:resource="#Staff"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#is_directed_by">
  <rdfs:domain rdf:resource="#Program"/>
  <rdfs:range rdf:resource="#Staff"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#school_name">
  <rdfs:domain rdf:resource="#School"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#staff_id">
  <rdfs:domain rdf:resource="#Staff"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#staff_title">
  <rdfs:domain rdf:resource="#Staff"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#student_id">
  <rdfs:domain rdf:resource="#Student"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#person_name">
  <rdfs:domain rdf:resource="#Staff"/>
  <rdfs:domain rdf:resource="#Student"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#program_title">
  <rdfs:domain rdf:resource="#Program"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#program_id">
  <rdfs:domain rdf:resource="#Module"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#program_length">
  <rdfs:domain rdf:resource="#Program"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#module_title">
  <rdfs:domain rdf:resource="#Module"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#module_id">
  <rdfs:domain rdf:resource="#Module"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#Staff">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Student">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Program">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Module">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#School">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:NamedIndividual rdf:about="#eeecs">
  <rdf:type rdf:resource="#School"/>
  <offers_program rdf:resource="#mscaift"/>
  <school_name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EEECS</school_name>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#mscaift">
  <rdf:type rdf:resource="#Program"/>
  <has_module rdf:resource="#knowledgeengineering"/>
  <is_directed_by rdf:resource="#barrydevereux"/>
  <program_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MSc AI Full-time</program_title>
  <program_id rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12345</program_id>
  <program_length rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1 year</program_length>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#knowledgeengineering">
  <rdf:type rdf:resource="#Module"/>
  <is_taught_by rdf:resource="#iainstyles"/>
  <module_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Knowledge Engineering</module_title>
  <module_id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ECS8052</module_id>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#iainstyles">
  <rdf:type rdf:resource="#Staff"/>
  <person_name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Iain Styles</person_name>
  <staff_id rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">894567</staff_id>
  <staff_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Professor</staff_title>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#barrydevereux">
  <rdf:type rdf:resource="#Staff"/>
  <person_name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Barry Devereux</person_name>
  <staff_id rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">678945</staff_id>
  <staff_title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dr</staff_title>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#alanturing">
  <rdf:type rdf:resource="#Student"/>
  <is_enrolled_on rdf:resource="#mscaift"/>
  <person_name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Alan Turing</person_name>
  <student_id rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">234567</student_id>
</owl:NamedIndividual>


</rdf:RDF>
